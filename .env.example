# Copy this file to .env (in the repo root, next to docker-compose.yml).
# docker compose reads it automatically. .env is git-ignored; never commit it.

# Shared secret between the server and the code runner. Generate one with:
#   openssl rand -hex 32
RUNNER_TOKEN=

# Optional: how many programs run at once (default 2). The server and the
# runner both read this, so they always agree.
# MAX_CONCURRENT_RUNS=2
