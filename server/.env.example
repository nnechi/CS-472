GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SESSION_SECRET=
APP_URL=
# app_url will change based on frontend
# Running code. Under docker compose this is set up for you: the server sends
# runs to the sandboxed runner service and ignores the line below.
# Running the server outside Docker (npm run dev) has no runner, so Run is
# refused unless you uncomment this. It runs student code directly on your
# machine with no sandbox: local development only, never in production.
# ALLOW_UNSANDBOXED_RUNS=1
